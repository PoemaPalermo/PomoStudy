# Cargar imágenes
def load_image(path):
    return ImageTk.PhotoImage(Image.open(path))

images = {
    "btn_start": {
        "normal": load_image("desing/btn_start.png"),
        "pressed": load_image("desing/btn_start_pressed.png")
    },
    "btn_stop": {
        "normal": load_image("desing/btn_stop.png"),
        "pressed": load_image("desing/btn_stop_pressed.png")
    },
    "btn_reset": {
        "normal": load_image("desing/btn_reset.png"),
        "pressed": load_image("desing/btn_reset_pressed.png")
    },
    "bg_pomodoro": {
        "study": load_image("desing/panel_study.png"),
        "rest": load_image("desing/panel_rest.png")
    },
    "btn_pomodoro":{
        "normal": load_image("desing/btn_pomodoro.png"),
        "pressed": load_image("desing/btn_pomodoro_pressed.png")
    }
}

#BUTTONS
active_button = None

# Funciones
def reset_buttons():
    startbutton.config(image=images["btn_start"]["normal"])
    startbutton.image = images["btn_start"]["normal"]

    stopbutton.config(image=images["btn_stop"]["normal"])
    stopbutton.image = images["btn_stop"]["normal"]

    resetbutton.config(image=images["btn_reset"]["normal"])
    resetbutton.image = images["btn_reset"]["normal"]


def activate_button(button, key):
    global active_button

    reset_buttons()
    active_button = key

    button.config(image=images[key]["pressed"])
    button.image = images[key]["pressed"]

    print(f"Botón activo: {active_button}") 

    '''
    if active_button == "btn_start":
        start_timer()
    elif active_button == "btn_stop":
        stop_timer()
    elif active_button == "btn_reset":
        reset_timer()
'''


# Botones
startbutton = ttkb.Button(
    window,
    image=images["btn_start"]["normal"],
    bootstyle="success-link",
    takefocus=False,
    command=lambda: activate_button(startbutton, "btn_start")
)
startbutton.image = images["btn_start"]["normal"]
startbutton.grid(column=7, row=1, columnspan=2, sticky="ns", padx=10)


stopbutton = ttkb.Button(
    window,
    image=images["btn_stop"]["normal"],
    bootstyle="success-link",
    takefocus=False,
    command=lambda: activate_button(stopbutton, "btn_stop")
)
stopbutton.image = images["btn_stop"]["normal"]
