import tkinter as tk
from tkinter import ttk
from PIL import Image, ImageTk
import ttkbootstrap as ttkb
from ttkbootstrap.constants import *

#window
window = ttkb.Window(themename="vapor")
window.geometry("650x759")
window.title("PomoDesk")


#grid configuration
for col in range(24):
    if col % 3 == 0:
        window.columnconfigure(col, weight=1)
    else:
        window.columnconfigure(col, weight=2)

window.rowconfigure(0, weight=4)
window.rowconfigure(1, weight=5)
window.rowconfigure(2, weight=12)
window.rowconfigure(3, weight=11)
window.rowconfigure(4, weight=18)
window.rowconfigure(5, weight=6)
window.rowconfigure((6,8,10), weight=1)
window.rowconfigure((7,9), weight=7)


#CHRONOMETER
chronometer = tk.Label(
    window, 
    text="00:00", 
    font=("Arial",70), 
    borderwidth=0, 
    highlightthickness=0, 
    relief="flat")
chronometer.grid(column=10, row=3, columnspan=5, sticky="nsew")

#BUTTONS

# Cargar imágenes
def load_image(path):
    return ImageTk.PhotoImage(Image.open(path))

images = {
    "start": {
        "normal": load_image("start_button.png"),
        "pressed": load_image("start_button_pressed.png")
    },
    "stop": {
        "normal": load_image("stop_button.png"),
        "pressed": load_image("stop_button_pressed.png")
    },
    "reset": {
        "normal": load_image("reset_button.png"),
        "pressed": load_image("reset_button_pressed.png")
    }
}
active_button = None

# Funciones
def reset_buttons():
    startbutton.config(image=images["start"]["normal"])
    startbutton.image = images["start"]["normal"]

    stopbutton.config(image=images["stop"]["normal"])
    stopbutton.image = images["stop"]["normal"]

    resetbutton.config(image=images["reset"]["normal"])
    resetbutton.image = images["reset"]["normal"]


def activate_button(button, key):
    global active_button

    reset_buttons()
    active_button = key

    button.config(image=images[key]["pressed"])
    button.image = images[key]["pressed"]

    print(f"Botón activo: {active_button}") 


# Botones
startbutton = ttkb.Button(
    window,
    image=images["start"]["normal"],
    bootstyle="success-link",
    takefocus=False,
    command=lambda: activate_button(startbutton, "start")
)
startbutton.image = images["start"]["normal"]
startbutton.grid(column=1, row=1, padx=10)


stopbutton = ttkb.Button(
    window,
    image=images["stop"]["normal"],
    bootstyle="success-link",
    takefocus=False,
    command=lambda: activate_button(stopbutton, "stop")
)
stopbutton.image = images["stop"]["normal"]
stopbutton.grid(column=2, row=1, padx=10)


resetbutton = ttkb.Button(
    window,
    image=images["reset"]["normal"],
    bootstyle="success-link",
    takefocus=False,
    command=lambda: activate_button(resetbutton, "reset")
)
resetbutton.image = images["reset"]["normal"]
resetbutton.grid(column=3, row=1, padx=10)



window.tk.mainloop()